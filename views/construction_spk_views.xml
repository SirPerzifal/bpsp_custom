<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_discipline_list" model="ir.ui.view">
        <field name="name">construction.discipline.list</field>
        <field name="model">construction.discipline</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="view_construction_spk_list" model="ir.ui.view">
        <field name="name">construction.spk.list</field>
        <field name="model">construction.spk</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_late" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="block" optional="show"/>
                <field name="unit" optional="show"/>
                <field name="discipline_id"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="progress" widget="progressbar"/>
                <field name="grand_total" sum="Total"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'confirmed'"
                    decoration-primary="state == 'progress'"
                    decoration-success="state == 'done'"
                    decoration-muted="state == 'closed'"/>
                <field name="is_late" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_spk_kanban" model="ir.ui.view">
        <field name="name">construction.spk.kanban</field>
        <field name="model">construction.spk</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="discipline_id"/>
                <field name="progress"/>
                <field name="is_late"/>
                <progressbar field="state" colors='{"done": "success", "progress": "warning", "closed": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="discipline_id"/>
                        <field name="partner_id"/>
                        <field name="progress" widget="progressbar"/>
                        <span t-if="record.is_late.raw_value" class="text-danger">Lewat jatuh tempo</span>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_construction_spk_form" model="ir.ui.view">
        <field name="name">construction.spk.form</field>
        <field name="model">construction.spk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Konfirmasi" class="btn-primary" invisible="state != 'draft'" groups="bpsp_custom.group_spk_manager"/>
                    <button name="action_progress" type="object" string="Mulai" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Selesai" class="btn-primary" invisible="state != 'progress'"/>
                    <button name="action_close" type="object" string="Tutup" invisible="state != 'done'" groups="bpsp_custom.group_spk_manager"/>
                    <button name="action_draft" type="object" string="Kembali ke Draft" invisible="state != 'confirmed'" groups="bpsp_custom.group_spk_manager"/>
                    <button name="action_open_bom_wizard" type="object" string="Muat dari BoM" invisible="state in ('done', 'closed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,progress,done,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="task_id" readonly="state != 'draft'"/>
                            <field name="block" readonly="state != 'draft'"/>
                            <field name="unit" readonly="state != 'draft'"/>
                            <field name="unit_type" readonly="state != 'draft'"/>
                            <field name="discipline_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="partner_phone"/>
                            <field name="user_id" readonly="state == 'closed'"/>
                            <field name="analytic_account_id" readonly="state != 'draft'"/>
                            <field name="progress" widget="progressbar" readonly="state in ('draft', 'closed')"/>
                            <field name="is_late" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_issued" readonly="state != 'draft'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="actual_start" readonly="state in ('draft', 'closed')"/>
                            <field name="actual_end" readonly="state in ('draft', 'closed')"/>
                            <field name="total_work_value"/>
                            <field name="total_material"/>
                            <field name="grand_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lingkup Pekerjaan" name="scope">
                            <field name="line_ids" readonly="state in ('done', 'closed')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="notes"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kebutuhan Material" name="material">
                            <field name="material_ids" readonly="state in ('done', 'closed')">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="planned_qty"/>
                                    <field name="actual_qty"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                    <field name="move_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timesheet" name="timesheet">
                            <field name="timesheet_ids" context="{'default_spk_id': id, 'default_project_id': project_id, 'default_task_id': task_id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="employee_id"/>
                                    <field name="name"/>
                                    <field name="unit_amount" widget="float_time"/>
                                    <field name="project_id" column_invisible="1"/>
                                    <field name="task_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ringkasan" name="summary">
                            <group>
                                <field name="total_work_value"/>
                                <field name="total_material"/>
                                <field name="grand_total"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_spk_search" model="ir.ui.view">
        <field name="name">construction.spk.search</field>
        <field name="model">construction.spk</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="block"/>
                <field name="unit"/>
                <field name="discipline_id"/>
                <field name="partner_id"/>
                <filter name="late" string="Lewat Jatuh Tempo" domain="[('is_late', '=', True)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="progress" string="Berjalan" domain="[('state', '=', 'progress')]"/>
                <filter name="done" string="Selesai" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_project" string="Proyek" context="{'group_by': 'project_id'}"/>
                    <filter name="group_block" string="Blok" context="{'group_by': 'block'}"/>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit'}"/>
                    <filter name="group_discipline" string="Jenis Pekerjaan" context="{'group_by': 'discipline_id'}"/>
                    <filter name="group_partner" string="Sub-Kontraktor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_spk" model="ir.actions.act_window">
        <field name="name">SPK</field>
        <field name="res_model">construction.spk</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_construction_spk_search"/>
        <field name="context">{'search_default_progress': 0}</field>
    </record>

    <record id="action_construction_discipline" model="ir.actions.act_window">
        <field name="name">Jenis Pekerjaan</field>
        <field name="res_model">construction.discipline</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_spk_bom_wizard_form" model="ir.ui.view">
        <field name="name">spk.bom.wizard.form</field>
        <field name="model">spk.bom.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="spk_id" invisible="1"/>
                    <field name="bom_id"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_load_materials" type="object" string="Muat Material" class="btn-primary"/>
                    <button string="Batal" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
