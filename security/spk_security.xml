<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_spk">
        <field name="name">SPK</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_spk_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_spk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Melihat SPK, proyek, dan timesheet.</field>
    </record>

    <record id="group_spk_creator" model="res.groups">
        <field name="name">Creator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_spk"/>
        <field name="implied_ids" eval="[(4, ref('group_spk_user')), (4, ref('project.group_project_user'))]"/>
        <field name="comment">Site supervisor: membuat dan mengubah SPK.</field>
    </record>

    <record id="group_spk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_spk"/>
        <field name="implied_ids" eval="[(4, ref('group_spk_creator')), (4, ref('project.group_project_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
        <field name="comment">Project manager: mengonfirmasi dan menutup SPK.</field>
    </record>
</odoo>
